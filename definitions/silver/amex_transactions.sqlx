config {
    type: "table",
    schema: "silver_clean_data",
    name: "amex_transactions",
    description: "Cleaned and deduplicated American Express credit card transactions"
}

WITH
  staged AS (
  SELECT
    *,
    _FILE_NAME AS file_source,
    ROW_NUMBER() OVER (PARTITION BY _FILE_NAME, `Date`, `Description`, SAFE_CAST(Amount AS NUMERIC),
      _FILE_NAME ) AS intra_file_occurrence
  FROM
    ${ref("raw_amex_c_trans")} )
SELECT
  `Date` AS transaction_date,
  TRIM(`Description`) AS description,
  -- Invert amount signage to align with Chase standard
  SAFE_CAST(Amount AS NUMERIC) * -1 AS amount,
  CASE
    WHEN Category IS NULL THEN 'Payment'
    ELSE TRIM(Category)
END
  AS raw_category,
  CASE
    WHEN Category IS NULL THEN 'Payment'
    WHEN Category LIKE 'Fees & Adjustments%' THEN 'Return'
    ELSE 'Sale'
END
  AS transaction_type,
  file_source,
  CURRENT_TIMESTAMP() AS processed_at
FROM
  staged
WHERE
  `Date` IS NOT NULL
QUALIFY
  ROW_NUMBER() OVER (PARTITION BY `Date`, `Description`, Amount, intra_file_occurrence ORDER BY file_source DESC ) = 1
