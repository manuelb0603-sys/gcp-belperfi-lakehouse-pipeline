node_modules/

# Ignore sensitive configs, PII mappings, and local environments
config.json
.env

# Ignore raw CSV files
*.csv

# Ignore Python bytecode caches
__pycache__/
*.pyc

# Ignore local SQLite memory databases
agent/memory/*.sqlite3
agent/memory/*.sql
agent/runs/

# Ignore VS Code settings and launch profiles
.vscode/

# Ignore personal Claude Code settings and its worktrees
.claude/settings.local.json
.claude/worktrees/

# Ignore local-only experiments and standalone apps
/Scripts/local_experiments/